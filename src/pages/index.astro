---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
const href = (p) => (base + p).replace(/\/+/g, "/");

const PHONE = "(308) 537-8713";
const TEL = "+13085378713";
const EMAIL = "russx1967@hotmail.com";

const whatWeDo = [
  { t: "Quality Used Cars", d: "Dependable everyday vehicles, picked for value and checked over before they hit the lot. No junk, no surprises." },
  { t: "Classic & Vintage Tin", d: "Older American iron for the enthusiast, the restorer, or anyone who just loves an honest piece of rolling history." },
  { t: "Straight Talk, Fair Prices", d: "A small-town dealer who stands behind what he sells. You deal with the owner, not a sales floor." },
];

const steps = [
  { n: "01", t: "See what is on the lot", d: "Give a look at the current inventory or tell us what you are hunting for." },
  { n: "02", t: "Come kick the tires", d: "Stop by in Willow Island, take a look, take a drive, ask anything." },
  { n: "03", t: "Drive it home", d: "Simple paperwork, a fair handshake price, and the keys are yours." },
];
---
<Layout>
  <!-- NAV -->
  <nav class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="#top">
        <span class="brand-mark">VT</span>
        <span class="brand-name">Vintage Tin<span class="brand-sub">Auto Sales</span></span>
      </a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
      <div class="nav-links" id="nav-menu" hidden>
        <a href="#inventory">What We Sell</a>
        <a href="#how">How It Works</a>
        <a href="#about">About</a>
        <a class="btn btn-primary nav-cta" href="#contact">Contact</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <header class="hero" id="top">
    <div class="hero-bg" id="hero-bg" style={`background-image:url('${href("/images/hero.jpg")}')`} aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow hero-eyebrow reveal" data-reveal>Willow Island, Nebraska &middot; Licensed Dealer</p>
      <h1 class="hero-title reveal" data-reveal data-reveal-delay="1">Honest cars from an honest lot.</h1>
      <p class="lede reveal" data-reveal data-reveal-delay="2">Vintage Tin Auto Sales is a small-town Nebraska dealer run by Russell Parsons. Dependable used cars and classic vintage tin, priced fair, sold straight, no pressure.</p>
      <div class="hero-cta reveal" data-reveal data-reveal-delay="3">
        <a class="btn btn-primary" href={`tel:${TEL}`}>Call {PHONE}</a>
        <a class="btn btn-glass" href="#inventory">What we sell</a>
      </div>
      <ul class="hero-trust reveal" data-reveal data-reveal-delay="4">
        <li><strong>Licensed</strong> NE dealer</li>
        <li><strong>Owner</strong> run</li>
        <li><strong>No</strong> pressure</li>
      </ul>
    </div>
    <a class="hero-scroll reveal" href="#inventory" data-reveal data-reveal-delay="5" aria-label="Scroll down"><span></span></a>
  </header>

  <!-- INVENTORY / WHAT WE SELL -->
  <section id="inventory" class="section">
    <div class="wrap">
      <div class="section-head rise">
        <p class="eyebrow">What we sell</p>
        <h2>Used cars and classic iron, under one roof.</h2>
        <p class="sub">A rotating lot of dependable drivers and the occasional piece of vintage tin worth saving. Call to hear what is in stock right now.</p>
      </div>
      <div class="card-grid">
        {whatWeDo.map((s) => (
          <article class="card rise">
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </article>
        ))}
      </div>
      <p class="inv-note rise">Inventory changes often. The fastest way to see what is on the lot is to <a href={`tel:${TEL}`}>call {PHONE}</a>.</p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how" class="section band">
    <div class="wrap">
      <div class="section-head rise">
        <p class="eyebrow">How it works</p>
        <h2>Buying a car should be simple.</h2>
      </div>
      <div class="steps">
        {steps.map((s, i) => (
          <article class="step rise" data-reveal data-reveal-delay={String(i + 1)}>
            <span class="step-n">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="section">
    <div class="wrap about-grid">
      <div class="about-copy rise">
        <p class="eyebrow">About</p>
        <h2>A real dealer, not a car lot machine.</h2>
        <p>Vintage Tin Auto Sales is based in Willow Island, Nebraska and run by its owner, Russell Parsons. It is a licensed Nebraska motor vehicle dealer, which means the paperwork is done right and the title is clean.</p>
        <p>Being small is the point. You talk to the person who bought the car, priced the car, and is selling you the car. No quotas, no runaround, no nonsense.</p>
        <a class="btn btn-ghost" href="#contact">Get in touch</a>
      </div>
      <aside class="about-card rise">
        <h3 class="display">At a glance</h3>
        <ul>
          <li><span>Dealer</span><strong>Vintage Tin Auto Sales</strong></li>
          <li><span>Owner</span><strong>Russell Parsons</strong></li>
          <li><span>Location</span><strong>Willow Island, NE</strong></li>
          <li><span>Phone</span><strong><a href={`tel:${TEL}`}>{PHONE}</a></strong></li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section band">
    <div class="wrap contact-grid">
      <div class="rise">
        <p class="eyebrow">Contact</p>
        <h2>Looking for something? Let us know.</h2>
        <p>Tell us what you are after and we will tell you what we have, or keep an eye out for it. We will get back to you quick.</p>
        <p class="contact-line"><strong>Call or text:</strong> <a href={`tel:${TEL}`}>{PHONE}</a></p>
        <p class="contact-line"><strong>Email:</strong> <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
      </div>
      <form id="lead-form" class="rise" novalidate>
        <div class="field"><label for="name">Name</label><input id="name" name="name" required autocomplete="name" /></div>
        <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" inputmode="tel" autocomplete="tel" /></div>
        <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" /></div>
        <div class="field"><label for="message">What are you looking for?</label><textarea id="message" name="message" rows="4" placeholder="Daily driver, a project, a specific make or year..."></textarea></div>
        <button class="btn btn-primary" type="submit">Send it over</button>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="wrap foot-top">
      <div>
        <a class="brand" href="#top"><span class="brand-mark">VT</span><span class="brand-name">Vintage Tin<span class="brand-sub">Auto Sales</span></span></a>
        <p class="foot-note">Licensed Nebraska motor vehicle dealer. Used cars and classic vintage tin in Willow Island, NE.</p>
      </div>
      <div class="foot-contact">
        <a class="btn btn-primary" href={`tel:${TEL}`}>{PHONE}</a>
        <p class="foot-note">Owner run &middot; No pressure &middot; Fair prices</p>
      </div>
    </div>
    <div class="wrap foot-bar"><span>&copy; {new Date().getFullYear()} Vintage Tin Auto Sales</span><span>Willow Island, Nebraska</span></div>
  </footer>

  <script>
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("nav-menu");
    if (toggle && menu) toggle.addEventListener("click", () => {
      const open = menu.hasAttribute("hidden");
      if (open) { menu.removeAttribute("hidden"); toggle.setAttribute("aria-expanded", "true"); toggle.classList.add("open"); }
      else { menu.setAttribute("hidden", ""); toggle.setAttribute("aria-expanded", "false"); toggle.classList.remove("open"); }
    });
    menu && menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => {
      if (window.innerWidth <= 820) { menu.setAttribute("hidden", ""); toggle.setAttribute("aria-expanded", "false"); toggle.classList.remove("open"); }
    }));

    const form = document.getElementById("lead-form");
    const status = document.getElementById("form-status");
    if (form) form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = Object.fromEntries(new FormData(form).entries());
      status.textContent = "Sending...";
      try {
        const r = await fetch("/api/contact", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(fd) });
        const j = await r.json();
        if (j.ok) { status.textContent = "Thanks. We got it and will reach out soon."; form.reset(); }
        else { status.textContent = j.error || "Something went wrong. Please call us instead."; }
      } catch { status.textContent = "Something went wrong. Please call us instead."; }
    });

    // Hero parallax — background drifts slower than the page for a subtle depth effect.
    (function(){
      const bg = document.getElementById("hero-bg");
      const hero = document.querySelector(".hero");
      if (!bg || !hero) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const SPEED = 0.4;
      let ticking = false;
      function update(){
        const rect = hero.getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < window.innerHeight){
          const scrolled = Math.max(-rect.top, 0);
          bg.style.setProperty("--py", (scrolled * SPEED) + "px");
        }
        ticking = false;
      }
      function onScroll(){ if (!ticking){ ticking = true; requestAnimationFrame(update); } }
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    })();
  </script>

  <style>
    /* NAV */
    .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; background: linear-gradient(to bottom, rgba(36,27,22,.55), transparent); transition: background .3s, box-shadow .3s; }
    .nav.scrolled { background: var(--cream); box-shadow: 0 2px 14px rgba(36,27,22,.12); }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 68px; }
    .brand { display: flex; align-items: center; gap: .6rem; }
    .brand-mark { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 6px; background: var(--ox); color: var(--cream); font-family: "Oswald", sans-serif; font-weight: 700; font-size: 1.05rem; }
    .brand-name { font-family: "Oswald", sans-serif; text-transform: uppercase; font-weight: 700; font-size: 1.05rem; line-height: .95; color: var(--cream); display: flex; flex-direction: column; }
    .nav.scrolled .brand-name { color: var(--ink); }
    .brand-sub { font-size: .62rem; letter-spacing: .22em; color: var(--gold); font-weight: 600; }
    .nav-links { display: flex; align-items: center; gap: 1.6rem; }
    .nav-links a { font-family: "Oswald", sans-serif; text-transform: uppercase; letter-spacing: .05em; font-size: .9rem; font-weight: 500; color: var(--cream); }
    .nav.scrolled .nav-links a { color: var(--ink); }
    .nav-links a.nav-cta { color: var(--cream); }
    .nav-cta { padding: .5rem 1.1rem; }
    .nav-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 6px; }
    .nav-toggle span { width: 24px; height: 2px; background: var(--cream); transition: .25s; }
    .nav.scrolled .nav-toggle span { background: var(--ink); }
    .nav-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle.open span:nth-child(2) { opacity: 0; }
    .nav-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* HERO */
    .hero { position: relative; min-height: min(94vh, 840px); display: flex; align-items: flex-end; overflow: hidden; }
    .hero-bg { position: absolute; left: 0; right: 0; top: -12%; height: 124%; background-size: cover; background-position: center; transform: translate3d(0, var(--py, 0px), 0) scale(1.04); will-change: transform; animation: heroZoom 18s ease-out forwards; }
    @keyframes heroZoom { from { transform: translate3d(0, var(--py, 0px), 0) scale(1.12); } to { transform: translate3d(0, var(--py, 0px), 0) scale(1.04); } }
    .hero-scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(28,20,16,.92) 0%, rgba(28,20,16,.55) 38%, rgba(28,20,16,.25) 70%, rgba(28,20,16,.4) 100%); }
    .hero-inner { position: relative; z-index: 2; padding: 7rem clamp(1.1rem, 4vw, 2rem) clamp(3rem, 6vw, 5rem); max-width: 760px; }
    .hero-eyebrow { color: #e9b94e; }
    .hero-title { color: var(--cream); font-size: clamp(2.6rem, 6.4vw, 5rem); margin: .6rem 0 1.1rem; text-shadow: 0 2px 24px rgba(0,0,0,.35); }
    .hero .lede { color: #efe6d7; font-size: clamp(1.05rem, 1.7vw, 1.3rem); max-width: 620px; }
    .hero-cta { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 1.8rem; }
    .hero-trust { list-style: none; display: flex; flex-wrap: wrap; gap: 1.8rem; margin-top: 2.2rem; }
    .hero-trust li { color: #d9ccba; font-size: .9rem; text-transform: uppercase; letter-spacing: .08em; font-family: "Oswald", sans-serif; }
    .hero-trust strong { display: block; color: var(--cream); font-size: 1.5rem; }
    .hero-scroll { position: absolute; left: 50%; bottom: 20px; transform: translateX(-50%); z-index: 2; width: 24px; height: 40px; border: 2px solid rgba(248,242,231,.6); border-radius: 14px; }
    .hero-scroll span { position: absolute; left: 50%; top: 7px; width: 4px; height: 8px; margin-left: -2px; background: var(--cream); border-radius: 2px; animation: scrollDot 1.6s ease-in-out infinite; }
    @keyframes scrollDot { 0%,100% { opacity: 0; transform: translateY(0); } 50% { opacity: 1; transform: translateY(8px); } }

    /* SECTION HEADS */
    .section-head { max-width: 680px; margin-bottom: 2.4rem; }
    .section-head h2 { margin: .5rem 0 .6rem; }
    .section-head .sub { font-size: 1.05rem; }
    .band { background: var(--paper-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }

    /* CARDS */
    .card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
    .card { background: var(--cream); border: 1px solid var(--line); border-top: 3px solid var(--ox); border-radius: var(--radius); padding: 1.6rem; transition: transform .25s ease, box-shadow .25s ease; }
    .card:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(36,27,22,.12); }
    .card h3 { margin-bottom: .5rem; }
    .card p { font-size: .98rem; }
    .inv-note { margin-top: 1.8rem; font-size: 1rem; }
    .inv-note a, .contact-line a, .about-card a { color: var(--ox); font-weight: 600; }

    /* STEPS */
    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
    .step { background: var(--cream); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.6rem; }
    .step-n { font-family: "Oswald", sans-serif; font-weight: 700; font-size: 1.4rem; color: var(--ox); letter-spacing: .05em; }
    .step h3 { margin: .5rem 0 .4rem; }
    .step p { font-size: .96rem; }

    /* ABOUT */
    .about-grid { display: grid; grid-template-columns: 1.3fr .9fr; gap: clamp(1.6rem, 4vw, 3rem); align-items: center; }
    .about-copy h2 { margin: .5rem 0 1rem; }
    .about-copy p { margin-bottom: 1rem; }
    .about-copy .btn { margin-top: .4rem; }
    .about-card { background: var(--steel); color: var(--cream); border-radius: var(--radius); padding: 1.8rem; }
    .about-card h3 { color: var(--cream); margin-bottom: 1rem; }
    .about-card ul { list-style: none; }
    .about-card li { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem 0; border-bottom: 1px solid rgba(248,242,231,.14); }
    .about-card li:last-child { border-bottom: 0; }
    .about-card span { color: #b9b2a6; font-size: .9rem; text-transform: uppercase; letter-spacing: .06em; font-family: "Oswald", sans-serif; }
    .about-card strong { color: var(--cream); }
    .about-card a { color: #e9b94e; }

    /* CONTACT */
    .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.6rem, 4vw, 3rem); align-items: start; }
    .contact-grid h2 { margin: .5rem 0 .8rem; }
    .contact-line { margin-top: .6rem; }
    #lead-form { background: var(--cream); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.6rem; }
    .field { margin-bottom: 1rem; }
    .field label { display: block; font-family: "Oswald", sans-serif; text-transform: uppercase; letter-spacing: .05em; font-size: .82rem; margin-bottom: .35rem; color: var(--ink); }
    .field input, .field textarea { width: 100%; padding: .7rem .8rem; border: 1px solid var(--line); border-radius: 5px; background: var(--paper); font: inherit; color: var(--ink); }
    .field input:focus, .field textarea:focus { outline: 2px solid var(--ox); outline-offset: 1px; border-color: var(--ox); }
    .form-status { margin-top: .8rem; font-size: .95rem; color: var(--ox); min-height: 1.2em; }

    /* FOOTER */
    .footer { background: var(--ink); color: var(--cream); padding: 2.6rem 0 1.6rem; }
    .footer .brand-name { color: var(--cream); }
    .foot-top { display: flex; justify-content: space-between; gap: 1.6rem; flex-wrap: wrap; align-items: center; }
    .foot-note { color: #c3b7a7; font-size: .9rem; margin-top: .7rem; max-width: 420px; }
    .foot-contact { text-align: right; }
    .foot-bar { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; padding-top: 1.2rem; border-top: 1px solid rgba(248,242,231,.14); color: #a99d8d; font-size: .85rem; }

    @media (max-width: 820px) {
      .nav-toggle { display: flex; }
      .nav-links { position: absolute; top: 68px; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 0; background: var(--cream); padding: .6rem 1.1rem 1.1rem; box-shadow: 0 10px 24px rgba(36,27,22,.14); }
      .nav-links[hidden] { display: none !important; }
      .nav-links a { color: var(--ink) !important; padding: .8rem 0; border-bottom: 1px solid var(--line); }
      .nav-cta { text-align: center; margin-top: .6rem; border-bottom: 0 !important; }
      .card-grid, .steps { grid-template-columns: 1fr; }
      .about-grid, .contact-grid { grid-template-columns: 1fr; }
      .foot-contact { text-align: left; }
      .hero { min-height: 88vh; }
      .hero-inner { padding-top: 6rem; }
      .hero-title { font-size: clamp(2.1rem, 9vw, 3rem); }
      .hero .lede { font-size: 1.02rem; }
      .hero-trust { gap: 1.1rem; margin-top: 1.8rem; }
      .hero-trust li { font-size: .8rem; }
      .hero-trust strong { font-size: 1.2rem; }
      .hero-cta { gap: .7rem; }
      .hero-cta .btn { flex: 1 1 auto; text-align: center; }
    }
  </style>
</Layout>
